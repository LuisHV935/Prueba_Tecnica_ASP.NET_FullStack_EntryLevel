@model IEnumerable<ProjectTask>

@{
    ViewData["Title"] = "Tareas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Lista de Tareas</h1>
    <a asp-action="Create" class="btn btn-primary">+ Nueva Tarea</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Título</th>
                <th>Estado</th>
                <th>Creada</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var task in Model)
            {
                <tr>
                    <td>@task.Id</td>
                    <td>@task.Title</td>
                    <td>
                        <span class="badge @(task.Status == "Completed" ? "bg-success" : task.Status == "InProgress" ? "bg-warning text-dark" : "bg-secondary")">
                            @(task.Status switch { "Completed" => "Completada", "InProgress" => "En Progreso", _ => "Pendiente" })
                        </span>
                    </td>
                    <td>@task.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-info text-white">Detalle</a>
                        <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Delete" asp-route-id="@task.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <p class="fs-5">No hay tareas registradas.</p>
        <a asp-action="Create" class="btn btn-primary">Crear primera tarea</a>
    </div>
}
